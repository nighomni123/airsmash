# Dependencies (no trailing slash: also covers the node_modules symlink to shared tooling)
node_modules

# Lockfile: the single dev dep (playwright) is hard-pinned in package.json —
# a lockfile would resolve ^1.45.1 to a newer, untested 1.x that breaks on
# macOS 12 (Chromium install refusal, see AGENTS.md).
package-lock.json

# Local tooling caches
.npm-cache/
.pw-browsers/
.gh-config/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
*.log
npm-debug.log*

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Environment & secrets
.env
.env.*

# OS / misc
Thumbs.db
